UTXOPLAY_STORE_ORIGIN=https://store.utxoplay.io
UTXOPLAY_PROJECT_ID=replace-with-studio-project-id
UTXOPLAY_VERIFICATION_TOKEN=replace-with-studio-verification-token
UTXOPLAY_VENDOR_KEY=replace-with-server-only-studio-launch-key
VENDOR_PUBLIC_ORIGIN=https://play.example.com
VENDOR_GAME_URL=https://play.example.com/game
MYELIN_RUNTIME_URL=http://127.0.0.1:8781
MYELIN_RUNTIME_TOKEN=replace-with-an-independent-random-secret
